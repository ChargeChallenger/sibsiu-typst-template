// Различия между видами учебных работ.
//
// Вид работы задаётся одним параметром kind у work(), а не правкой
// титульного листа: раньше «отчёт по практическим» получался
// редактированием значений по умолчанию в title.typ, из-за чего
// ветки работ было невозможно слить обратно.

#let kinds = (
  // Курсовой проект: с отдельной страницей задания, утверждаемой кафедрой.
  coursework: (
    work-type: "КУРСОВОЙ ПРОЕКТ",
    supervisor-label: "Руководитель курсового проекта:",
    supervisor-role: "Руководитель курсового проекта",
    assignment: true,
  ),
  // Отчёт по практическим занятиям: задания на бланке кафедры нет.
  practice: (
    work-type: "ОТЧЕТ ПО ПРАКТИЧЕСКИМ ЗАНЯТИЯМ",
    supervisor-label: "Преподаватель:",
    supervisor-role: "Преподаватель",
    assignment: false,
  ),
  // Расчётно-графическая работа.
  rgr: (
    work-type: "РАСЧЕТНО-ГРАФИЧЕСКАЯ РАБОТА",
    supervisor-label: "Преподаватель:",
    supervisor-role: "Преподаватель",
    assignment: false,
  ),
)

#let resolve-kind(kind) = {
  if kind not in kinds {
    panic(
      "неизвестный вид работы: " + kind + ". Доступны: " + kinds.keys().join(", "),
    )
  }
  kinds.at(kind)
}
